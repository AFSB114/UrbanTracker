{
  "expo": {
    "name": "UrbanTracker",
    "slug": "UrbanTracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "urbantracker",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/Isotipo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "extra": {
      "apiUrl": "http://192.168.0.110:8080/api/v1",
      "mqttHost": "192.168.0.110",
      "mqttPort": 9001,
      "router": {
        "root": "./src/app"
      },
      "eas": {
        "projectId": "425ae1a2-e353-4305-b0ed-13c6dc9b4b41"
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Esta aplicación necesita acceso a tu ubicación para mostrarte conductores cercanos y calcular rutas."
        }
      ],
      [
        "expo-router",
        {
          "root": "./src/app"
        }
      ],
      "expo-asset"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.UrbanTracker",
      "splash": {
        "image": "./assets/Isotipo.png",
        "resizeMode": "contain",
        "backgroundColor": "#ffffff"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Esta aplicación necesita acceso a tu ubicación para mostrarte conductores cercanos y calcular rutas."
      }
    },
    "android": {
      "package": "com.anonymous.UrbanTracker",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#000000"
      },
      "splash": {
        "image": "./assets/Isotipo.png",
        "resizeMode": "contain",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    }
  }
}

