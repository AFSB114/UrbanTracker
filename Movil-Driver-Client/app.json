{
  "expo": {
    "name": "UrbanTracker",
    "slug": "UrbanTracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "urbantracker",
    "userInterfaceStyle": "auto",
    "icon": "./assets/Logotipo.png",
    "splash": {
      "image": "./assets/Isotipo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff",
      "tabletImage": "./assets/Isotipo.png",
      "tabletResizeMode": "contain",
      "tabletBackgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "extra": {
      "apiUrl": "http://192.168.0.110:8080/api/v1",
      "mqttHost": "192.168.0.110",
      "mqttPort": 9001,
      "router": {
        "root": "./src/app"
      },
      "eas": {
        "projectId": "425ae1a2-e353-4305-b0ed-13c6dc9b4b41"
      }
    },
    "permissions": [
      "ACCESS_COARSE_LOCATION",
      "ACCESS_FINE_LOCATION"
    ],
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Esta aplicación necesita acceso a tu ubicación para mostrarte conductores cercanos y calcular rutas."
        }
      ],
      [
        "expo-router",
        {
          "root": "./src/app"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.UrbanTracker",
      "splash": {
        "image": "./assets/Isotipo.png",
        "resizeMode": "contain",
        "backgroundColor": "#ffffff",
        "tabletImage": "./assets/Isotipo.png",
        "tabletResizeMode": "contain",
        "tabletBackgroundColor": "#ffffff"
      }
    },
    "android": {
      "package": "com.anonymous.UrbanTracker",
      "adaptiveIcon": {
        "foregroundImage": "./assets/Logotipo.png",
        "backgroundColor": "#000000"
      },
      "splash": {
        "image": "./assets/Isotipo.png",
        "resizeMode": "contain",
        "backgroundColor": "#000"
      },
      "statusBar": {
        "translucent": true,
        "backgroundColor": "#000000",
        "barStyle": "dark-content"
      },
      "networkSecurityConfig": {
        "domainConfig": {
          "domain": [
            "*"
          ],
          "cleartextTrafficPermitted": true
        }
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    }
  }
}
